{
  "name": "congruence-solver",
  "description": "Single variable linear and quadratic congruence solver",
  "sideEffects": false,
  "version": "0.2.0",
  "type": "module",
  "author": {
    "name": "Péter Pallos"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pallosp/congruence_solver.git"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || ^24.11.0 || >=26.0.0",
      "onFail": "error"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "math",
    "congruence",
    "linear congruence",
    "quadratic congruence",
    "modular arithmetic",
    "number theory",
    "Tonelli-Shanks",
    "Hensel lifting",
    "Chinese remainder theorem"
  ],
  "scripts": {
    "benchmark": "tsx benchmark/benchmark",
    "build": "tsdown",
    "coverage": "vitest run --coverage",
    "lint": "eslint",
    "prepublishOnly": ".husky/pre-commit && npm run build",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "publint": "^0.3.25",
    "tinybench": "^6.2.4",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
